# ~/.config/git/config — shared, identity-free git settings.
#
# Git reads this XDG file first and ~/.gitconfig after it, so anything in
# ~/.gitconfig wins. Keep per-machine / per-employer settings there (or in a
# file it includes), never here:
#   user.name / user.email, user.signingkey, gpg.*, commit.gpgsign,
#   credential helpers (their paths differ per machine).
# See README.md "Git identity" for a work/personal split with includeIf.
#
# core.pager/delta.* assume `delta` is installed (scripts/install_libraries.sh
# does that); without it, git log/diff would fail to page.

[core]
  pager = delta
  editor = nvim

[interactive]
  diffFilter = delta --color-only

[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta

[delta]
  plus-style = "syntax #119711"
  minus-style = "syntax #340001"
  syntax-theme = Monokai Extended
  navigate = true
  side-by-side = true
  line-numbers = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[init]
  defaultBranch = main

[pull]
  rebase = true
