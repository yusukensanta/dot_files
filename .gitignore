.cache
__pycache__/
*.pyc
.rustup
.zsh_history
.config/mise
.local
.gnupg
.npm
.cargo
.ssh
.claude/

# Defense-in-depth: sync_to_host.sh/sync_here.sh only ever touch the
# whitelisted TARGET_DIRS (nvim, zsh, sheldon, starship) plus a few named
# files, so none of these are ever written by those scripts. Listed anyway
# so a manual `git add`/`git add -A` in this repo can't accidentally commit
# real credentials sitting alongside them in $HOME.
.aws
.config/gcloud
.docker
.kube
.netrc
.npmrc
.pgpass
.env
.env.*

*.md
!README.md

.config/zsh/.zcompdump*
.config/zsh/90-local.zsh
.config/zsh/local.d/*
!.config/zsh/local.d/.gitkeep

# Only allowlisted docs are tracked; any other *.md stays ignored so
# point-in-time notes can't be committed by accident.
!.config/nvim/doc/KEYMAP.md
!.config/nvim/doc/README.md
!.config/nvim/doc/lua-basics.md
!.config/nvim/doc/lua-recipes.md
!.config/nvim/doc/module-organization.md
!.config/nvim/doc/neovim-lua-api.md
!.config/nvim/doc/plugin-development.md
!.config/nvim/doc/plugin-templates.md

.config/nvim/lua/local/*
!.config/nvim/lua/local/.gitkeep

!.config/zsh/ZLE-WIDGETS-REFERENCE.md
